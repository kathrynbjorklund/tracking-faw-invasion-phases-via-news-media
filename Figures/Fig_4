# Plot 
ggplot(sumBV.df, aes(x = Phase1, y = Phase2)) +
  geom_point(aes(shape = continent), color = "black", alpha = 0.7, size = 3) +
  geom_smooth(method = "lm", colour = "black", se = TRUE) +
  facet_wrap(Phase1N + Phase2N ~ ., ncol = 1) +
