  theme_bw() +
  theme(
    axis.title.y = element_text(size = 12),
    strip.text = element_text(size = 12),
    legend.text = element_text(size = 12),
    plot.title = element_text(size = 12, hjust = 0.5),
    plot.caption = element_text(hjust = 0.5, size = 12, margin = margin(t = 10))
  )
